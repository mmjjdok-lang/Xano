			local n = i
			list[i] = { "Mix " .. n, function(c)
				c.all("Color", Color3.fromHSV((n * 0.137) % 1, 0.7, 1))
				c.all("Material", MIX_MATS[n % #MIX_MATS + 1])
			end }
		end
	end
	return list
end

local TRAIL_SPOTS = {
	-- {R15 name, R6 name, fraction of part height (R15), fraction (R6)}
	{ "LeftUpperArm", "Left Arm", 0.5, 0.5 }, { "RightUpperArm", "Right Arm", 0.5, 0.5 }, -- shoulders
	{ "LeftHand", "Left Arm", 0, -0.5 }, { "RightHand", "Right Arm", 0, -0.5 }, -- hands
	{ "LeftUpperLeg", "Left Leg", -0.5, 0 }, { "RightUpperLeg", "Right Leg", -0.5, 0 }, -- knees
}

local function EnsureTrails(char)
	local f = char:FindFirstChild("HE_Trails")
	if f then return f end
	f = Instance.new("Folder")
	f.Name = "HE_Trails"
	f.Parent = char
	for _, s in ipairs(TRAIL_SPOTS) do
		local part, frac = char:FindFirstChild(s[1]), s[3]
		if not (part and part:IsA("BasePart")) then part, frac = char:FindFirstChild(s[2]), s[4] end
		if part and part:IsA("BasePart") then
			local y = part.Size.Y * frac
			local a0 = Instance.new("Attachment"); a0.Name = "HE_A0"; a0.Position = Vector3.new(0, y + 0.18, 0); a0.Parent = part
			local a1 = Instance.new("Attachment"); a1.Name = "HE_A1"; a1.Position = Vector3.new(0, y - 0.18, 0); a1.Parent = part
			local tr = Instance.new("Trail")
			tr.Attachment0, tr.Attachment1 = a0, a1
			tr.Color = ColorSequence.new(Color3.fromRGB(190, 90, 255), Color3.fromRGB(100, 20, 200))
			tr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
			tr.Lifetime = 0.7
			tr.MinLength = 0.05
			tr.LightEmission = 0.8
			tr.FaceCamera = true
			tr.Enabled = false
			tr.Parent = f
		end
	end
	return f
end

function Pane:AddAvatarEffects(o)
	o = o or {}
	local count = math.clamp(math.floor(o.Count or 30), 1, 60)
	local list = EffectList(count)
	local names = {}
	for i, e in ipairs(list) do names[i] = e[1] end

	local card = self:_card(126)
	local sq = New("Frame", { Position = UDim2.fromOffset(10, 11), Size = UDim2.fromOffset(104, 104), BackgroundColor3 = T.track, ClipsDescendants = true, Parent = card })
