	local resetB = New("TextButton", { Text = "Reset", TextSize = 11, TextXAlignment = Enum.TextXAlignment.Center, BackgroundTransparency = 0, BackgroundColor3 = T.item2, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 9), Size = UDim2.fromOffset(52, 22), Parent = card })
	Corner(resetB, 5)
	local ddFrame = New("Frame", { Position = UDim2.fromOffset(126, 54), Size = UDim2.new(1, -136, 0, 32), BackgroundColor3 = T.item2, Parent = card })
	Corner(ddFrame, 6)
	Stroke(ddFrame, T.stroke, 1)
	local valL = New("TextLabel", { TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -30, 1, 0), Parent = ddFrame })
	New("TextLabel", { Text = "▾", TextSize = 12, TextColor3 = T.sub, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 0), Size = UDim2.fromOffset(18, 32), Parent = ddFrame })
	local ddHit = New("TextButton", { Size = UDim2.fromScale(1, 1), Parent = ddFrame })
	New("TextLabel", { Text = "Pick an effect — it applies instantly", TextSize = 10, TextColor3 = T.sub, Position = UDim2.fromOffset(126, 92), Size = UDim2.new(1, -136, 0, 14), Parent = card })

	local snap, snapChar, currentIdx
	local conns = {}
	local function snapshot(char, hum)
		local s = { parts = {}, decals = {}, scales = {} }
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then s.parts[d] = { d.Color, d.Material, d.Transparency }
			elseif d:IsA("Decal") then s.decals[d] = d.Transparency end
		end
		if hum then
			for _, n in ipairs(SCALES) do
				local v = hum:FindFirstChild(n)
				if v and v:IsA("NumberValue") then s.scales[v] = v.Value end
			end
		end
		return s
	end
	local function clearFx()
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		conns = {}
		if snap then
			for p, v in pairs(snap.parts) do if p.Parent then p.Color, p.Material, p.Transparency = v[1], v[2], v[3] end end
			for d, v in pairs(snap.decals) do if d.Parent then d.Transparency = v end end
			for n, v in pairs(snap.scales) do if n.Parent then n.Value = v end end
		end
		local ch = LocalPlayer.Character
		local f = ch and ch:FindFirstChild("HE_Trails")
		if f then for _, t in ipairs(f:GetChildren()) do t.Enabled = false end end
	end
	local function updatePreview()
		for _, c in ipairs(vp:GetChildren()) do if c:IsA("Model") then c:Destroy() end end
		local char = LocalPlayer.Character
		if not char then return end
		local ok, clone = pcall(function() char.Archivable = true; return char:Clone() end)
		if not ok or not clone then return end
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("Trail") then d:Destroy() end
		end
		local hrp = clone:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.Anchored = true
			clone.Parent = vp
			cam.CFrame = CFrame.lookAt(hrp.Position + hrp.CFrame.LookVector * 6.5 + Vector3.new(0, 1.2, 0), hrp.Position + Vector3.new(0, 0.6, 0))
		else
			clone:Destroy()
		end
	end
	local function applyIdx(idx)
		local char = LocalPlayer.Character
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if snapChar ~= char then clearFx(); snap = snapshot(char, hum); snapChar = char end
		clearFx()
		currentIdx = idx
		if not idx then task.delay(0.5, updatePreview); return end
		local trails = EnsureTrails(char)
		for _, t in ipairs(trails:GetChildren()) do t.Enabled = true end
		local ctx = { conns = conns }
		function ctx.set(namesT, prop, val)
			for _, n in ipairs(namesT) do
				local p = char:FindFirstChild(n)
				if p and p:IsA("BasePart") then p[prop] = val end
			end
		end
		function ctx.all(prop, val)
			for _, p in ipairs(char:GetDescendants()) do
				if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p[prop] = val end
			end
		end
		function ctx.scale(n, v)
			local nv = hum and hum:FindFirstChild(n)
			if nv and nv:IsA("NumberValue") then nv.Value = v end
		end
		function ctx.face(v)
			local h = char:FindFirstChild("Head")
			if h then for _, d in ipairs(h:GetChildren()) do if d:IsA("Decal") then d.Transparency = v end end end
		end
		pcall(list[idx][2], ctx)
		task.delay(0.6, updatePreview)
	end

	local dd = DropdownCore(self.Win, ddFrame, { Options = names, Search = true, Callback = function(v)
		local idx = table.find(names, v)
		if idx then applyIdx(idx) end
	end }, valL)
	ddHit.Activated:Connect(function() Click(); dd:Toggle() end)
	resetB.Activated:Connect(function() Click(); applyIdx(nil); dd:Set(nil) end)

	Bind(LocalPlayer.CharacterAdded, function(char)
		task.wait(1.2)
		snapChar = nil
		if currentIdx then applyIdx(currentIdx) else updatePreview() end
	end)
	table.insert(self.Win.Cleanups, function() pcall(clearFx) end)
	task.spawn(function() task.wait(0.5); updatePreview() end)
	self:_reg({ Name = o.Name or "Avatar Effects", Type = "Dropdown", Icon = "user", Card = card })
	return { Card = card, Apply = function(_, n) local i = table.find(names, n); if i then dd:Set(n); applyIdx(i) end end }
end

-- ---------------------- Tab: inner tabs ----------------------
function TabMT:_refreshStrip()
	local strip = self.Strip
	local hasStrip = #self.Inners > 0
	local off = hasStrip and 32 or 0
	strip.Visible = hasStrip
	local entries = {}
	if self._used then entries[#entries + 1] = { pane = self, name = "General" } end
	for _, ip in ipairs(self.Inners) do entries[#entries + 1] = { pane = ip, name = ip.Title, icon = ip.IconRef } end
	local all = { self }
	for _, ip in ipairs(self.Inners) do all[#all + 1] = ip end
	for _, p in ipairs(all) do
		p.Scroll.Position = UDim2.fromOffset(0, off)
		p.Scroll.Size = UDim2.new(1, 0, 1, -off)
	end
	if not hasStrip then self.Scroll.Visible = true; return end

	for _, c in ipairs(self.StripHolder:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
	local win = self.Win
	for i, e in ipairs(entries) do
		local b = New("Frame", { Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, LayoutOrder = i, Parent = self.StripHolder })
		New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = b })
		if e.icon then
			local h = MakeIcon(b, e.icon, "▪", 14)
			h.LayoutOrder = 1
		end
		local lbl = New("TextLabel", { Text = e.name, TextSize = 12, TextColor3 = T.sub, Size = UDim2.new(0, 0, 0, 18), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = 2, Parent = b })
		local hit = New("TextButton", { Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = b })
		hit.Activated:Connect(function() Click(); self:_selectInner(e.pane) end)
		e.btn, e.lbl = b, lbl
	end
	self._entries = entries
	local keep
	for _, e in ipairs(entries) do if e.pane == self._sel then keep = e.pane end end
	self:_selectInner(keep or entries[1].pane, true)
end

function TabMT:_selectInner(pane, instant)
	if not self._entries then return end
	self._sel = pane
	local off = 32
	local target
	for _, e in ipairs(self._entries) do
		local on = e.pane == pane
		e.pane.Scroll.Visible = on
		if e.lbl then Tw(e.lbl, 0.2, { TextColor3 = on and T.white or T.sub }) end
		if on then target = e end
	end
	for _, ip in ipairs(self.Inners) do
		if ip ~= pane then ip.Scroll.Visible = false end
	end
	if not self._used or pane ~= self then self.Scroll.Visible = (pane == self) end
	if not instant then
		pane.Scroll.Position = UDim2.fromOffset(0, off + 12)
		Tw(pane.Scroll, 0.28, { Position = UDim2.fromOffset(0, off) })
	end
	task.spawn(function()
		task.wait(0.06)
		if target and target.btn and target.btn.Parent then
			local s = win_scale(self)
			local x = (target.btn.AbsolutePosition.X - self.Strip.AbsolutePosition.X) / s
			local w = target.btn.AbsoluteSize.X / s
			Tw(self.Ind, instant and 0 or 0.25, { Position = UDim2.fromOffset(x, 28), Size = UDim2.fromOffset(w, 2) })
		end
	end)
end

function win_scale(tab) return tab.Win.UIScale.Scale end

function TabMT:AddInnerTab(o)
	o = type(o) == "string" and { Name = o } or (o or {})
	local ip = NewPane(self.Win, self.Page, o.Name or "Inner", Pane)
