local IconLib
pcall(function() IconLib = loadstring(game:HttpGet(ICONS_URL))() end)

local function ResolveIcon(name)
	if not IconLib then return end
	local ok, a, b = pcall(function()
		if type(IconLib.Icon) == "function" then return IconLib.Icon(name) end
		if type(IconLib.GetIcon) == "function" then return IconLib.GetIcon(name) end
		return IconLib[name]
	end)
	if not ok or a == nil then return end
	local img, size, pos
	if type(a) == "string" or type(a) == "number" then
		img = a
		if type(b) == "table" then size = b.ImageRectSize; pos = b.ImageRectPosition or b.ImageRectOffset end
	elseif type(a) == "table" then
		img = a[1] or a.Image or a.Id or a.image
		local r = type(a[2]) == "table" and a[2] or a
		size = r.ImageRectSize
		pos = r.ImageRectPosition or r.ImageRectOffset
	end
	if type(img) == "number" then img = "rbxassetid://" .. img end
	if type(img) ~= "string" then return end
	return img, size, pos
end

local function ApplyIcon(img, icon, fb)
	img.ImageRectSize = Vector2.zero
	img.ImageRectOffset = Vector2.zero
	local src, size, pos
	if type(icon) == "number" then
		src = "rbxassetid://" .. icon
	elseif type(icon) == "string" and icon ~= "" then
		if icon:match("^%d+$") then src = "rbxassetid://" .. icon
		elseif icon:find("rbxasset", 1, true) or icon:find("http", 1, true) then src = icon
		else src, size, pos = ResolveIcon(icon) end
	end
	if src then
		img.Image = src
		if typeof(size) == "Vector2" then img.ImageRectSize = size end
		if typeof(pos) == "Vector2" then img.ImageRectOffset = pos end
		img.Visible = true
		if fb then fb.Visible = false end
		task.delay(3, function()
			if img.Parent and not img.IsLoaded then
				img.Visible = false
				if fb then fb.Visible = true end
			end
		end)
	else
		img.Visible = false
		if fb then fb.Visible = true end
	end
end

local function MakeIcon(parent, icon, glyph, size, pos, anchor)
	local holder = New("Frame", { Size = UDim2.fromOffset(size, size), Position = pos or UDim2.new(), AnchorPoint = anchor or Vector2.zero, BackgroundTransparency = 1, Parent = parent })
	local img = New("ImageLabel", { Size = UDim2.fromScale(1, 1), Parent = holder })
	local fb = New("TextLabel", { Size = UDim2.fromScale(1, 1), Text = glyph or "•", TextSize = math.floor(size * 0.85), TextXAlignment = Enum.TextXAlignment.Center, Parent = holder })
	ApplyIcon(img, icon, fb)
	return holder, function(newIcon) ApplyIcon(img, newIcon, fb) end
end

-- ===================== DRAG (single finger, heavy) =====================
local function MakeDraggable(frame, handles, cfg)
	cfg = cfg or {}
	local smooth = cfg.Smooth
	local dragInput, startIn, startPos, target, cur, rs
	local moved = 0
	local ctl = {}

	local function clamp(v)
		local s = VP()
		local sz = frame.AbsoluteSize
		return Vector2.new(math.clamp(v.X, 0, math.max(s.X - sz.X, 0)), math.clamp(v.Y, 0, math.max(s.Y - sz.Y, 0)))
	end
	function ctl.Clamp()
		local p = clamp(Vector2.new(frame.Position.X.Offset, frame.Position.Y.Offset))
		frame.Position = UDim2.fromOffset(p.X, p.Y)
	end
	local function stopRS() if rs then rs:Disconnect(); rs = nil end end
	local function startRS()
		if rs then return end
		rs = RunService.RenderStepped:Connect(function(dt)
			local a = 1 - (1 - smooth) ^ (math.clamp(dt, 0, 0.1) * 60)
			cur = cur:Lerp(target, a)
			if not dragInput and (cur - target).Magnitude < 0.4 then cur = target; stopRS() end
			frame.Position = UDim2.fromOffset(cur.X, cur.Y)
		end)
	end
	local function begin(input)
		if dragInput then return end -- another finger already owns the drag
		dragInput = input
		startIn = Vector2.new(input.Position.X, input.Position.Y)
		startPos = Vector2.new(frame.Position.X.Offset, frame.Position.Y.Offset)
		target, cur, moved = startPos, startPos, 0
		if smooth then startRS() end
		if cfg.OnStart then cfg.OnStart() end
	end
	for _, h in ipairs(handles) do
		h.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then begin(i) end
		end)
	end
	Bind(UIS.InputChanged, function(i)
		if not dragInput then return end
		local ok = (i == dragInput) or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and i.UserInputType == Enum.UserInputType.MouseMovement)
		if not ok then return end
		local d = Vector2.new(i.Position.X, i.Position.Y) - startIn
		moved = math.max(moved, d.Magnitude)
		target = clamp(startPos + d)
		if not smooth then cur = target; frame.Position = UDim2.fromOffset(target.X, target.Y) end
	end)
	Bind(UIS.InputEnded, function(i)
		if not dragInput then return end
		if i == dragInput or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and i.UserInputType == Enum.UserInputType.MouseButton1) then
			dragInput = nil
			if cfg.OnEnd then cfg.OnEnd(moved) end
		end
	end)
	Bind(Gui:GetPropertyChangedSignal("AbsoluteSize"), function() ctl.Clamp() end)
	return ctl
end

-- ===================== CLASSES =====================
local Window = {}
Window.__index = Window
local Pane = {}
Pane.__index = Pane
local TabMT = setmetatable({}, { __index = Pane })
TabMT.__index = TabMT

local function NewPane(win, parent, title, mt, flat)
	local scroll = New("ScrollingFrame", { Size = UDim2.fromScale(1, 1), Parent = parent })
	New("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 6), Parent = scroll })
	New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
	return setmetatable({ Win = win, Scroll = scroll, List = scroll, Title = title or "", Flat = flat, _o = 0 }, mt or Pane)
end

function Pane:_next()
	self._o = self._o + 1
	if not self._used then
		self._used = true
		if self.Owner == self and self.Owner._refreshStrip then self:_refreshStrip() end
	end
	return self._o
end

function Pane:_slot()
	local r = self._row
	if r then
		local col = r.cols[r.i]
		r.i = r.i % #r.cols + 1
		return col
	end
	return self.List
end

function Pane:Divide(n)
	n = math.clamp(math.floor(tonumber(n) or 1), 1, 3) -- max 3
	self._img = nil
	if n == 1 then self._row = nil; return end
	local row = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = self:_next(), Parent = self.List })
	New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Top, Parent = row })
	local cols = {}
	for i = 1, n do
		local c = New("Frame", { Size = UDim2.new(1 / n, -(6 * (n - 1)) / n, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = i, Parent = row })
		New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = c })
		cols[i] = c
	end
	self._row = { cols = cols, i = 1 }
end
Pane.AddDivision = Pane.Divide

function Pane:_card(h)
	self._img = nil
	local f = New("Frame", {
		Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = T.item, BackgroundTransparency = self.Flat and 1 or 0,
		LayoutOrder = self:_next(), Parent = self:_slot(),
	})
	if not self.Flat then Corner(f, 6); Stroke(f, T.stroke, 1) end
	return f
end

local function Texts(card, name, desc, pad, rightPad)
	local has = desc and desc ~= ""
	local n = New("TextLabel", {
		Text = name, Position = UDim2.fromOffset(pad, has and 5 or 0),
		Size = UDim2.new(1, -(pad + rightPad), 0, has and 17 or card.Size.Y.Offset),
		TextTruncate = Enum.TextTruncate.AtEnd, Parent = card,
	})
	local d
	if has then
		d = New("TextLabel", { Text = desc, TextSize = 11, TextColor3 = T.sub, Position = UDim2.fromOffset(pad, 22), Size = UDim2.new(1, -(pad + rightPad), 0, 14), TextTruncate = Enum.TextTruncate.AtEnd, Parent = card })
	end
	return n, d
end

local function PressFX(hit, card, flat)
	if flat then return end
	hit.MouseEnter:Connect(function() Tw(card, 0.12, { BackgroundColor3 = T.item2 }) end)
	hit.MouseLeave:Connect(function() Tw(card, 0.2, { BackgroundColor3 = T.item }) end)
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
			Tw(card, 0.08, { BackgroundColor3 = T.item2 })
		end
	end)
	hit.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
			Tw(card, 0.25, { BackgroundColor3 = T.item })
		end
	end)
end

local function MakeFocus(pane, card)
	return function()
		local tab = pane.Tab
		if tab then
			tab:Select()
			if pane ~= tab and tab._selectInner then tab:_selectInner(pane) end
		end
		task.defer(function()
			pcall(function()
				local sc = pane.Scroll
				local s = pane.Win.UIScale.Scale
				sc.CanvasPosition = Vector2.new(0, math.max(0, (card.AbsolutePosition.Y - sc.AbsolutePosition.Y) / s + sc.CanvasPosition.Y - 8))
			end)
			local st = card:FindFirstChildOfClass("UIStroke")
			if st then
				st.Color = T.white
				Tw(st, 0.8, { Color = T.stroke })
			end
		end)
	end
end

function Pane:_reg(e)
	e.Tab = self.Title
	e.Pane = self
	if not self.NoSearch then
		e.Focus = MakeFocus(self, e.Card)
		table.insert(self.Win.Registry, e)
		self.Win:_queueShortcuts()
	end
	return e
end

function Pane:_flag(name, get, set)
	local base = ((self.Tab and self.Tab.Title) or "") .. "/" .. (self.Title or "") .. "/" .. tostring(name)
	local key, n = base, 1
	while self.Win.Flags[key] do n = n + 1; key = base .. "#" .. n end
	self.Win.Flags[key] = { Get = get, Set = set }
end

-- ---------------------- Button ----------------------
function Pane:AddButton(o)
	o = type(o) == "string" and { Name = o } or (o or {})
	local desc = o.Desc or o.Description
	local card = self:_card((desc and desc ~= "") and 42 or 34)
	local pad = self.Flat and 2 or 10
	local nameL, descL = Texts(card, o.Name or "Button", desc, pad, 14)
	local hit = New("TextButton", { Size = UDim2.fromScale(1, 1), Parent = card })
	PressFX(hit, card, self.Flat)
	local function fire() Click(); Safe(o.Callback) end
	hit.Activated:Connect(fire)

	local obj = { Card = card }
	function obj:Fire() fire() end
	function obj:SetName(t) nameL.Text = t end

	local win = self.Win
	function obj:AddSettings(title)
		if self._sp then return self._sp end
		nameL.Size = UDim2.new(1, -(pad + 44), nameL.Size.Y.Scale, nameL.Size.Y.Offset)
		if descL then descL.Size = UDim2.new(1, -(pad + 44), 0, 14) end
		local dots = New("TextButton", { Text = "⋯", TextSize = 20, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(30, 26), Parent = card })
		local sp = win:_newSettingsPage(title or ((o.Name or "Button") .. " Settings"), self.Pane)
		dots.Activated:Connect(function() Click(); sp:Open() end)
		self._sp = sp
		return sp
	end
	obj.Pane = self
	if o.Settings then obj:AddSettings(type(o.Settings) == "string" and o.Settings or nil) end

	self:_reg({ Name = o.Name or "Button", Type = "Button", Icon = o.Icon, Card = card, Fire = fire })
	return obj
end

-- ---------------------- Toggle ----------------------
function Pane:AddToggle(o)
	o = type(o) == "string" and { Name = o } or (o or {})
	local desc = o.Desc or o.Description
	local card = self:_card((desc and desc ~= "") and 42 or 34)
	local pad = self.Flat and 2 or 10
	Texts(card, o.Name or "Toggle", desc, pad, 64)
	local win = self.Win
	local track = New("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -pad, 0.5, 0), Size = UDim2.fromOffset(42, 20), BackgroundColor3 = T.track, Parent = card })
	Corner(track, 4)
	local tStroke = Stroke(track, T.stroke, 1)
	local knob = New("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(18, 14), BackgroundColor3 = T.white, Parent = track })
	Corner(knob, 3)
	New("UIGradient", { Color = ColorSequence.new(T.white, Color3.fromRGB(35, 35, 35)), Rotation = 0, Parent = knob })
	local hit = New("TextButton", { Size = UDim2.fromScale(1, 1), Parent = card })
	PressFX(hit, card, self.Flat)

	local value = false
	local entry
	local obj = {}
	local function apply(v, silent)
		value = v and true or false
		Tw(knob, 0.2, { Position = value and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0), BackgroundTransparency = value and 0 or 0.35 })
		Tw(track, 0.2, { BackgroundColor3 = value and T.item2 or T.track })
		Tw(tStroke, 0.2, { Color = value and win.Accent or T.stroke })
		if entry and entry.OnState then entry.OnState(value) end
		if not silent then Safe(o.Callback, value) end
	end
	function obj:Set(v, silent) apply(v, silent) end
	function obj:Get() return value end
	obj.Card = card
	local function flip() Click(); apply(not value) end
	hit.Activated:Connect(flip)

	value = o.Default and true or false
	knob.Position = value and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
	knob.BackgroundTransparency = value and 0 or 0.35
	track.BackgroundColor3 = value and T.item2 or T.track
	tStroke.Color = value and win.Accent or T.stroke

	entry = self:_reg({ Name = o.Name or "Toggle", Type = "Toggle", Icon = o.Icon, Card = card, Fire = flip, State = function() return value end })
	if not o.NoSave then self:_flag(o.Name or "Toggle", function() return value end, function(v) apply(v) end) end
	if value and o.Callback then Safe(o.Callback, value) end
	return obj
end

-- ---------------------- Slider ----------------------
function Pane:AddSlider(o)
	o = o or {}
	local min, max = o.Min or 0, o.Max or 100
	local inc = o.Increment or 1
	local value = math.clamp(o.Default or min, min, max)
	local card = self:_card(46)
	local pad = self.Flat and 2 or 10
	New("TextLabel", { Text = o.Name or "Slider", Position = UDim2.fromOffset(pad, 4), Size = UDim2.new(1, -(pad * 2 + 60), 0, 18), TextTruncate = Enum.TextTruncate.AtEnd, Parent = card })
	local valL = New("TextLabel", { TextSize = 12, TextColor3 = T.sub, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -pad, 0, 4), Size = UDim2.fromOffset(56, 18), Parent = card })
	local track = New("Frame", { Position = UDim2.new(0, pad, 0, 31), Size = UDim2.new(1, -pad * 2, 0, 4), BackgroundColor3 = T.track, Parent = card })
	Corner(track, 2)
	local fill = New("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = self.Win.Accent, Parent = track })
	Corner(fill, 2)
	local knob = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(6, 14), BackgroundColor3 = T.white, Parent = fill })
	Corner(knob, 2)
	New("UIGradient", { Color = ColorSequence.new(T.white, Color3.fromRGB(60, 60, 60)), Rotation = 90, Parent = knob })
	local hit = New("TextButton", { Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 26), Parent = card })

	local function fmt(v) if inc % 1 == 0 then return tostring(math.floor(v + 0.5)) end return string.format("%.2f", v) end
	local function render(animate)
		local r = (max - min) == 0 and 0 or (value - min) / (max - min)
		if animate then Tw(fill, 0.15, { Size = UDim2.fromScale(r, 1) }) else fill.Size = UDim2.fromScale(r, 1) end
		valL.Text = fmt(value) .. (o.Suffix or "")
	end
	local function set(v, silent, animate)
		v = min + math.floor((v - min) / inc + 0.5) * inc
		v = math.clamp(v, min, max)
		local changed = v ~= value
		value = v
		render(animate)
		if changed and not silent then Safe(o.Callback, value) end
	end
	render()

	local dragIn
	local function fromX(x)
		local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		set(min + (max - min) * rel)
	end
	hit.InputBegan:Connect(function(i)
		if dragIn then return end
		if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragIn = i
			self.Scroll.ScrollingEnabled = false
			Tw(knob, 0.1, { Size = UDim2.fromOffset(8, 18) })
			fromX(i.Position.X)
		end
	end)
	Bind(UIS.InputChanged, function(i)
		if not dragIn then return end
		if i == dragIn or (dragIn.UserInputType == Enum.UserInputType.MouseButton1 and i.UserInputType == Enum.UserInputType.MouseMovement) then
			fromX(i.Position.X)
		end
	end)
	Bind(UIS.InputEnded, function(i)
		if dragIn and (i == dragIn or (dragIn.UserInputType == Enum.UserInputType.MouseButton1 and i.UserInputType == Enum.UserInputType.MouseButton1)) then
			dragIn = nil
			self.Scroll.ScrollingEnabled = true
			Tw(knob, 0.12, { Size = UDim2.fromOffset(6, 14) })
		end
	end)

	local obj = { Card = card }
	function obj:Set(v, silent) set(v, silent, true) end
	function obj:Get() return value end
	self:_reg({ Name = o.Name or "Slider", Type = "Slider", Icon = o.Icon, Card = card })
	if not o.NoSave then self:_flag(o.Name or "Slider", function() return value end, function(v) set(v, false, true) end) end
	return obj
end

