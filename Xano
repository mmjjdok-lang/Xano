-- ===================== HELPERS =====================
local function New(class, props, kids)
	local o = Instance.new(class)
	if o:IsA("GuiObject") then
		o.BorderSizePixel = 0
		if class == "Frame" then o.BackgroundColor3 = T.bg end
		if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
			o.BackgroundTransparency = 1
			o.Font = Enum.Font.GothamMedium
			o.TextColor3 = T.text
			o.TextSize = 13
			o.Text = ""
			o.TextXAlignment = Enum.TextXAlignment.Left
		end
		if class == "ImageLabel" or class == "ImageButton" then o.BackgroundTransparency = 1 end
		if o:IsA("GuiButton") then o.AutoButtonColor = false end
		if class == "ScrollingFrame" then
			o.BackgroundTransparency = 1
			o.ScrollBarThickness = 2
			o.ScrollBarImageColor3 = T.sub
			o.CanvasSize = UDim2.new()
			o.AutomaticCanvasSize = Enum.AutomaticSize.Y
			o.ScrollingDirection = Enum.ScrollingDirection.Y
		end
	end
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else o[k] = v end
	end
	for _, c in ipairs(kids or {}) do c.Parent = o end
	if parent then o.Parent = parent end
	return o
end

local function Tw(o, t, p, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), p)
	tw:Play()
	return tw
end

local function Corner(o, r) return New("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = o }) end
local function Stroke(o, c, th, tr)
	return New("UIStroke", { Color = c or T.stroke, Thickness = th or 1, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = o })
end

local function Safe(f, ...)
	if type(f) ~= "function" then return end
	local args = table.pack(...)
	task.spawn(function()
		local ok, e = pcall(f, table.unpack(args, 1, args.n))
		if not ok then warn("[HE] callback error: " .. tostring(e)) end
	end)
end

local function VP()
	local s = Gui.AbsoluteSize
	if s.X < 10 then s = Workspace.CurrentCamera.ViewportSize end
	return s
end

