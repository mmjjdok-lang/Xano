function TabMT:Select()
	local win = self.Win
	if win.CurrentTab == self then return end
	if win.Popup then win.Popup:Close() end
	if win.OpenSettings then win.OpenSettings:Close() end
	local prev = win.CurrentTab
	if prev then prev:_setActive(false) end
	win.CurrentTab = self
	self:_setActive(true)
end

function TabMT:_setActive(on)
	self.Page.Visible = on
