-- ---------------------- Folders (configs) ----------------------
local function canFS()
	return type(writefile) == "function" and type(isfolder) == "function" and type(makefolder) == "function"
end
local function clean(s) return (tostring(s):gsub("[^%w _%-]", ""):sub(1, 24)) end

function Window:_collect()
	local d = {}
	for k, f in pairs(self.Flags) do
		local ok, v = pcall(f.Get)
		if ok then d[k] = v end
	end
	return d
end
function Window:_applyCfg(d)
	for k, v in pairs(d) do
		local f = self.Flags[k]
		if f then pcall(f.Set, v) end
	end
end

function Window:_buildFolders(anchor)
	local win = self
	local dir = "HE_UI/" .. clean(self.Name)
	local obj = {}
	local open = false
	local popup = New("Frame", { Visible = false, BackgroundColor3 = T.panel, ClipsDescendants = true, ZIndex = 2, AnchorPoint = Vector2.new(1, 0), Parent = self.Overlay })
	Corner(popup, 6)
	Stroke(popup, T.stroke, 1)
	local addB = New("TextButton", { Text = "＋  Add Folder", TextSize = 12, Font = Enum.Font.GothamBold, BackgroundTransparency = 0, BackgroundColor3 = T.item2, Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 0, 28), Parent = popup })
	Corner(addB, 5)
	local inputRow = New("Frame", { Visible = false, Position = UDim2.fromOffset(6, 38), Size = UDim2.new(1, -12, 0, 28), BackgroundColor3 = T.item, Parent = popup })
	Corner(inputRow, 5)
	local nameBox = New("TextBox", { PlaceholderText = "Folder name...", PlaceholderColor3 = T.sub, ClearTextOnFocus = false, TextSize = 12, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -62, 1, 0), Parent = inputRow })
	local createB = New("TextButton", { Text = "Create", TextSize = 11, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, BackgroundTransparency = 0, BackgroundColor3 = T.white, TextColor3 = T.bg, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -3, 0.5, 0), Size = UDim2.fromOffset(50, 22), Parent = inputRow })
	Corner(createB, 4)
	local listF = New("ScrollingFrame", { Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 1, -44), Parent = popup })
	New("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder, Parent = listF })
	New("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), Parent = listF })

	local function sync() -- layout depends on whether the input row is shown
		local y = inputRow.Visible and 70 or 40
		listF.Position = UDim2.fromOffset(0, y)
		listF.Size = UDim2.new(1, 0, 1, -(y + 4))
	end
	local function saveDisk(name, data)
		if not canFS() then return end
		pcall(function()
			if not isfolder("HE_UI") then makefolder("HE_UI") end
			if not isfolder(dir) then makefolder(dir) end
			writefile(dir .. "/" .. name .. ".json", HttpService:JSONEncode(data))
		end)
	end
	local function delDisk(name)
		if type(delfile) == "function" then pcall(function() delfile(dir .. "/" .. name .. ".json") end) end
	end
	if canFS() and type(listfiles) == "function" then
		pcall(function()
			if isfolder(dir) then
				for _, p in ipairs(listfiles(dir)) do
					local n = tostring(p):match("([^/\\]+)%.json$")
					if n then self.Folders[n] = HttpService:JSONDecode(readfile(p)) end
				end
			end
		end)
	end

	local refresh
	refresh = function()
		for _, c in ipairs(listF:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
		local names = {}
		for n in pairs(win.Folders) do names[#names + 1] = n end
		table.sort(names)
		for i, n in ipairs(names) do
			local row = New("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = T.item, LayoutOrder = i, Parent = listF })
			Corner(row, 5)
			New("TextLabel", { Text = n, TextSize = 12, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -74, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
			local function ib(x, icon, glyph, fn)
				local b = New("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, x, 0.5, 0), Size = UDim2.fromOffset(26, 24), BackgroundTransparency = 0, BackgroundColor3 = T.item2, Parent = row })
				Corner(b, 5)
				MakeIcon(b, icon, glyph, 14, UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
				b.Activated:Connect(function() Click(); fn() end)
			end
			ib(-34, "trash", "🗑", function() win.Folders[n] = nil; delDisk(n); refresh() end)
			ib(-4, "check", "✔", function() win:_applyCfg(win.Folders[n]); obj:Close() end)
		end
		sync()
	end
	addB.Activated:Connect(function()
		Click()
		inputRow.Visible = not inputRow.Visible
		sync()
		if inputRow.Visible then nameBox:CaptureFocus() end
	end)
	local function create()
		local n = clean(nameBox.Text)
		if n == "" then return end
		win.Folders[n] = win:_collect()
		saveDisk(n, win.Folders[n])
		nameBox.Text = ""
		inputRow.Visible = false
		refresh()
	end
	createB.Activated:Connect(function() Click(); create() end)
	nameBox.FocusLost:Connect(function(enter) if enter then create() end end)

	function obj:Open()
		if open then return end
		open = true
		refresh()
		popup.Position = UDim2.fromOffset(win.W - 8, 44)
		popup.Size = UDim2.fromOffset(230, 0)
		popup.Visible = true
		win:_setPopup(obj, true)
		Tw(popup, 0.26, { Size = UDim2.fromOffset(230, 200) })
	end
	function obj:Close()
		if not open then return end
		open = false
		win:_clearPopup(obj)
		Tw(popup, 0.16, { Size = UDim2.fromOffset(230, 0) })
		task.delay(0.18, function() if not open then popup.Visible = false end end)
	end
	function obj:Toggle() if open then obj:Close() else obj:Open() end end
	return obj
end

-- ---------------------- Shortcuts window ----------------------
local DIGITS = { ["0"] = "Zero", ["1"] = "One", ["2"] = "Two", ["3"] = "Three", ["4"] = "Four", ["5"] = "Five", ["6"] = "Six", ["7"] = "Seven", ["8"] = "Eight", ["9"] = "Nine" }

function Window:_bind(e, kb)
	local txt = string.upper(string.sub(kb.Text, 1, 1))
	if txt == "" then
		if e.KeyCode then self.Binds[e.KeyCode] = nil end
		e.Key, e.KeyCode = nil, nil
		kb.Text = ""
		return
	end
	local ok, kc = pcall(function() return Enum.KeyCode[DIGITS[txt] or txt] end)
	if not ok or not kc then kb.Text = e.Key or ""; return end
	local other = self.Binds[kc]
	if other and other ~= e then other.Key, other.KeyCode = nil, nil end
	if e.KeyCode then self.Binds[e.KeyCode] = nil end
	e.Key, e.KeyCode = txt, kc
	self.Binds[kc] = e
	kb.Text = txt
	self:_queueShortcuts()
end

function Window:_buildShortcuts()
	local win = self
	local W2, H2 = 360, 300
	local s = VP()
	local sc = New("Frame", { Visible = false, Size = UDim2.fromOffset(W2, H2), Position = UDim2.fromOffset(math.max((s.X - W2) / 2 + 30, 0), math.max((s.Y - H2) / 2 + 20, 0)), BackgroundColor3 = T.bg, ClipsDescendants = true, ZIndex = 5, Parent = Gui })
	Corner(sc, 8)
	local st = Stroke(sc, T.stroke, 1)
	local scale = New("UIScale", { Scale = 0.001, Parent = sc })
	local top = New("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = T.panel, Parent = sc })
	New("TextLabel", { Text = "Shortcuts", Font = Enum.Font.GothamBold, TextSize = 14, Position = UDim2.fromOffset(12, 4), Size = UDim2.new(1, -60, 0, 18), Parent = top })
	New("TextLabel", { Text = "Tap a row to run it  •  type a letter to bind a key", TextSize = 10, TextColor3 = T.sub, Position = UDim2.fromOffset(12, 22), Size = UDim2.new(1, -60, 0, 14), Parent = top })
	New("Frame", { Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = T.white, Parent = top })
	local closeB = New("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 7), Size = UDim2.fromOffset(26, 26), BackgroundTransparency = 0, BackgroundColor3 = T.item, Parent = top })
	Corner(closeB, 5)
	MakeIcon(closeB, CLOSE_IMG, "✕", 14, UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
	local list = New("ScrollingFrame", { Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 1, -48), Parent = sc })
	New("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	New("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8), Parent = list })

	local drag = MakeDraggable(sc, { top }, {
		Smooth = 0.14,
		OnStart = function() Tw(scale, 0.15, { Scale = 0.985 }); Tw(st, 0.15, { Color = T.white }) end,
		OnEnd = function() Tw(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back); Tw(st, 0.3, { Color = T.stroke }) end,
	})

	local sh = { Frame = sc, Visible = false }
	function sh.Rebuild()
		for _, c in ipairs(list:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
		local n = 0
		for _, e in ipairs(win.Registry) do
			if e.Fire then
				n = n + 1
				e.StateLabel = nil
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = T.item, LayoutOrder = n, Parent = list })
				Corner(row, 6)
				Stroke(row, T.stroke, 1)
				New("TextLabel", { Text = e.Name, Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -120, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
				New("TextLabel", { Text = tostring(e.Tab) .. "  •  " .. e.Type, TextSize = 10, TextColor3 = T.sub, Position = UDim2.fromOffset(10, 21), Size = UDim2.new(1, -120, 0, 13), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
				local hit = New("TextButton", { Size = UDim2.new(1, -56, 1, 0), Parent = row })
				hit.MouseEnter:Connect(function() Tw(row, 0.12, { BackgroundColor3 = T.item2 }) end)
				hit.MouseLeave:Connect(function() Tw(row, 0.2, { BackgroundColor3 = T.item }) end)
				hit.Activated:Connect(function() e.Fire() end)
				if e.Type == "Toggle" and e.State then
					local sl = New("TextLabel", { TextSize = 11, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -56, 0.5, 0), Size = UDim2.fromOffset(40, 16), Parent = row })
					local function setS(v) sl.Text = v and "ON" or "OFF"; sl.TextColor3 = v and T.white or T.sub end
					setS(e.State())
					e.StateLabel = sl
					e.OnState = function(v) if sl.Parent then setS(v) end end
				end
				local kb = New("TextBox", { Text = e.Key or "", PlaceholderText = "Key", PlaceholderColor3 = T.sub, ClearTextOnFocus = true, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, BackgroundTransparency = 0, BackgroundColor3 = T.panel, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(40, 24), Parent = row })
				Corner(kb, 5)
				Stroke(kb, T.stroke, 1)
				kb.FocusLost:Connect(function() win:_bind(e, kb) end)
			end
		end
		if n == 0 then
			local f = New("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Parent = list })
			New("TextLabel", { Text = "No buttons or toggles yet.", TextColor3 = T.sub, TextSize = 12, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Parent = f })
		end
	end
	function sh.Show()
		sh.Visible = true
		sc.Visible = true
		drag.Clamp()
		sh.Rebuild()
		Tw(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	function sh.Hide()
		sh.Visible = false
		Tw(scale, 0.22, { Scale = 0.001 })
		task.delay(0.24, function() if not sh.Visible then sc.Visible = false end end)
	end
	function sh.Toggle() if sh.Visible then sh.Hide() else sh.Show() end end
	closeB.Activated:Connect(function() Click(); sh.Hide() end)
	self.Shortcuts = sh
end

-- ===================== OPEN BUTTON =====================
function Window:_buildOpenButton(cfg)
	cfg = cfg or {}
	local win = self
	local size = cfg.Size
	if typeof(size) == "Vector2" then size = UDim2.fromOffset(size.X, size.Y) end
	if typeof(size) ~= "UDim2" then size = UDim2.fromOffset(70, 40) end
	local b = New("Frame", {
		Size = size, Position = typeof(cfg.Position) == "UDim2" and cfg.Position or UDim2.new(0, 20, 0.5, -20),
		BackgroundColor3 = T.bg, BackgroundTransparency = cfg.Transparency or 0, Visible = false, ZIndex = 3, Parent = Gui,
	})
	Corner(b, 12)
	local st = Stroke(b, T.white, 1, cfg.CornerTransparency or 0.6)
	local hs = math.min(size.X.Offset, size.Y.Offset) - 14
	MakeIcon(b, cfg.Image or cfg.Icon, "HE", math.max(hs, 16), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
	local hit = New("TextButton", { Size = UDim2.fromScale(1, 1), Parent = b })
	local sc = New("UIScale", { Parent = b })
	local draggable = cfg.Draggable ~= false
	local drag
	if draggable then
		drag = MakeDraggable(b, { hit }, {
			OnStart = function() Tw(sc, 0.1, { Scale = 0.94 }) end,
			OnEnd = function(moved)
				Tw(sc, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
				if moved < 8 then Click(); win:Toggle() end
			end,
		})
	else
		hit.Activated:Connect(function() Click(); win:Toggle() end)
	end
	self.OpenBtn = b
	return b
end

-- ===================== CREATE WINDOW =====================
function Lib:CreateWindow(o)
	o = o or {}
	if env.__HE_WINDOW and env.__HE_WINDOW.Main and env.__HE_WINDOW.Main.Parent then
		warn("[HE] Window already exists.")
		return env.__HE_WINDOW
	end
	local win = setmetatable({}, Window)
	env.__HE_WINDOW = win
	local W, H = 600, 357
	if typeof(o.Size) == "UDim2" then W, H = o.Size.X.Offset, o.Size.Y.Offset
	elseif typeof(o.Size) == "Vector2" then W, H = o.Size.X, o.Size.Y end
	win.W, win.H = W, H
	win.Name = o.Name or "HE Hub"
	win.Accent = Lib.Colors[o.Color or "White"] or Lib.Colors.White
	win.Tabs, win.Registry, win.Flags, win.Folders, win.Binds, win.Cleanups = {}, {}, {}, {}, {}, {}
	win.ToggleKey = o.ToggleKey or Enum.KeyCode.RightShift
	win.Hidden = true
	win._so = 0

	-- Main frame
	local Main = New("Frame", { Name = "Main", Size = UDim2.fromOffset(W, H), BackgroundColor3 = T.bg, ClipsDescendants = true, Visible = false, Parent = Gui })
	Corner(Main, 8)
	local mStroke = Stroke(Main, T.stroke, 1)
	local UIsc = New("UIScale", { Scale = 0.001, Parent = Main })
	win.Main, win.UIScale = Main, UIsc
	local vp = VP()
	Main.Position = UDim2.fromOffset(math.max((vp.X - W) / 2, 0), math.max((vp.Y - H) / 2, 0))

	-- Top bar: title above the white line, subtitle under title
	local Top = New("Frame", { Size = UDim2.new(1, 0, 0, 47), BackgroundColor3 = T.panel, Parent = Main })
	local tx = 12
	if o.Icon then
		MakeIcon(Top, o.Icon, "◆", 24, UDim2.fromOffset(10, 9))
		tx = 42
	end
	New("TextLabel", { Text = win.Name, Font = Enum.Font.GothamBold, TextSize = 15, Position = UDim2.fromOffset(tx, 5), Size = UDim2.new(1, -(tx + 290), 0, 20), TextTruncate = Enum.TextTruncate.AtEnd, Parent = Top })
	New("TextLabel", { Text = o.SubTitle or "", TextSize = 11, TextColor3 = T.sub, Position = UDim2.fromOffset(tx, 26), Size = UDim2.new(1, -(tx + 290), 0, 14), TextTruncate = Enum.TextTruncate.AtEnd, Parent = Top })
	New("Frame", { Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = T.white, Parent = Top })

	local function TopBtn(i, icon, glyph, cb)
		local b = New("TextButton", { Size = UDim2.fromOffset(26, 26), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -(8 + i * 32), 0, 10), BackgroundTransparency = 0, BackgroundColor3 = T.item, Parent = Top })
		Corner(b, 5)
		Stroke(b, T.stroke, 1)
		MakeIcon(b, icon, glyph, 14, UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
		b.MouseEnter:Connect(function() Tw(b, 0.12, { BackgroundColor3 = T.item2 }) end)
		b.MouseLeave:Connect(function() Tw(b, 0.12, { BackgroundColor3 = T.item }) end)
		b.Activated:Connect(function() Click(); cb() end)
		return b
	end
	TopBtn(0, CLOSE_IMG, "✕", function() win:_confirmClose() end)
	TopBtn(1, HIDE_IMG, "—", function() win:Hide() end)
	TopBtn(2, "keyboard", "⌨", function() win.Shortcuts.Toggle() end)
	local foldersBtn = TopBtn(3, "folder", "📁", function() win.FoldersUI:Toggle() end)

	-- Layout bodies
	local SideW = 132
	local Side = New("Frame", { Position = UDim2.fromOffset(0, 47), Size = UDim2.new(0, SideW, 1, -47), BackgroundColor3 = T.panel, Parent = Main })
	New("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 1, 1, 0), BackgroundColor3 = T.stroke, Parent = Side })
	local SideList = New("ScrollingFrame", { Size = UDim2.new(1, -1, 1, 0), Parent = Side })
	New("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder, Parent = SideList })
	New("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = SideList })
	local Content = New("Frame", { Position = UDim2.fromOffset(SideW + 1, 48), Size = UDim2.new(1, -(SideW + 1), 1, -48), BackgroundTransparency = 1, ClipsDescendants = true, Parent = Main })
	win.SideList, win.Content = SideList, Content

	-- Overlay (popups) + ripple layer
	local Overlay = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 50, Parent = Main })
	local Blocker = New("TextButton", { Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 1, Parent = Overlay })
	Blocker.Activated:Connect(function() if win.Popup then win.Popup:Close() end end)
	win.Overlay, win.Blocker = Overlay, Blocker
	local RippleLayer = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 100, Active = false, Parent = Main })

	local function Ripple(pos)
		local rel = (pos - Main.AbsolutePosition) / UIsc.Scale
		local d = New("Frame", { Size = UDim2.fromOffset(0, 0), Position = UDim2.fromOffset(rel.X, rel.Y), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = T.white, BackgroundTransparency = 0.8, Parent = RippleLayer })
		Corner(d, 999)
		local s = math.max(W, H) * 0.5
		Tw(d, 0.65, { Size = UDim2.fromOffset(s, s), BackgroundTransparency = 1 }, Enum.EasingStyle.Sine)
		task.delay(0.7, function() d:Destroy() end)
	end
	Bind(UIS.InputBegan, function(i, gp)
		local pos
		if i.UserInputType == Enum.UserInputType.Touch then pos = Vector2.new(i.Position.X, i.Position.Y)
		elseif i.UserInputType == Enum.UserInputType.MouseButton1 then pos = UIS:GetMouseLocation()
		elseif i.UserInputType == Enum.UserInputType.Keyboard then
			if gp then return end
			if i.KeyCode == win.ToggleKey then win:Toggle(); return end
			local e = win.Binds[i.KeyCode]
			if e and e.Fire then e.Fire() end
			return
		end
		if pos and Main.Visible and not win.Hidden then
			local a, s = Main.AbsolutePosition, Main.AbsoluteSize
			if pos.X >= a.X and pos.X <= a.X + s.X and pos.Y >= a.Y and pos.Y <= a.Y + s.Y then Ripple(pos) end
		end
	end)

	-- Drag (heavy, single finger, with animation)
	win.Drag = MakeDraggable(Main, { Top, Side, Main }, {
		Smooth = 0.11,
		OnStart = function()
			if win.Popup then win.Popup:Close() end
			Tw(UIsc, 0.18, { Scale = win.Fit * 0.982 })
			Tw(mStroke, 0.18, { Color = T.white })
		end,
		OnEnd = function()
			Tw(UIsc, 0.3, { Scale = win.Fit }, Enum.EasingStyle.Back)
			Tw(mStroke, 0.35, { Color = T.stroke })
		end,
	})
	if o.Draggable == false then
		-- fixed window: re-centre every frame is unnecessary, simply cancel via clamp
		win.Drag = { Clamp = function() end }
	end
	Bind(Gui:GetPropertyChangedSignal("AbsoluteSize"), function() win:_refit() end)
	win:_refit(true)

	-- Search box (top right, magnifier on the left)
	if o.Search ~= false then
		local box = New("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -(8 + 4 * 32 + 2), 0, 11), Size = UDim2.fromOffset(124, 24), BackgroundColor3 = T.item, Parent = Top })
		Corner(box, 5)
		Stroke(box, T.stroke, 1)
		MakeIcon(box, SEARCH_IMG, "🔍", 14, UDim2.fromOffset(6, 5))
		local tb = New("TextBox", { PlaceholderText = "Search button...", PlaceholderColor3 = T.sub, ClearTextOnFocus = false, TextSize = 12, Position = UDim2.fromOffset(25, 0), Size = UDim2.new(1, -29, 1, 0), Parent = box })
		local pop = New("Frame", { Visible = false, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromOffset(W - (8 + 4 * 32 + 2), 42), Size = UDim2.fromOffset(230, 0), BackgroundColor3 = T.panel, ClipsDescendants = true, ZIndex = 2, Parent = Overlay })
		Corner(pop, 6)
		Stroke(pop, T.stroke, 1)
		local res = New("ScrollingFrame", { Size = UDim2.fromScale(1, 1), Parent = pop })
		New("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = res })
		New("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), Parent = res })
		local sObj = { open = false }
		function sObj:Close()
			if not sObj.open then return end
			sObj.open = false
			win:_clearPopup(sObj)
			Tw(pop, 0.15, { Size = UDim2.fromOffset(230, 0) })
			task.delay(0.17, function() if not sObj.open then pop.Visible = false end end)
		end
		local glyph = { Button = "▶", Toggle = "◐", Slider = "↔", Dropdown = "▾" }
		local function run()
			local q = string.lower(tb.Text)
			if q == "" then sObj:Close(); return end
			for _, c in ipairs(res:GetChildren()) do if c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end end
			local n = 0
			for _, e in ipairs(win.Registry) do
				if n >= 8 then break end
				if string.find(string.lower(e.Name), q, 1, true) then
					n = n + 1
					local r = New("TextButton", { Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = T.item, BackgroundTransparency = 0, LayoutOrder = n, Parent = res })
					Corner(r, 5)
					MakeIcon(r, e.Icon, glyph[e.Type] or "•", 16, UDim2.new(0, 7, 0.5, 0), Vector2.new(0, 0.5))
					New("TextLabel", { Text = e.Name, TextSize = 12, Position = UDim2.fromOffset(30, 0), Size = UDim2.new(1, -110, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = r })
					New("TextLabel", { Text = tostring(e.Tab), TextSize = 10, TextColor3 = T.sub, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 0), Size = UDim2.fromOffset(70, 30), TextTruncate = Enum.TextTruncate.AtEnd, Parent = r })
					r.Activated:Connect(function()
						Click()
						if e.Focus then e.Focus() end
						tb.Text = ""
						sObj:Close()
					end)
				end
			end
			if n == 0 then
				New("TextLabel", { Text = "No results", TextColor3 = T.sub, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 28), Parent = res })
				n = 1
			end
			local h = math.min(n * 32 + 8, 220)
			if not sObj.open then
				sObj.open = true
				pop.Size = UDim2.fromOffset(230, 0)
				pop.Visible = true
				win:_setPopup(sObj, false)
			end
			Tw(pop, 0.2, { Size = UDim2.fromOffset(230, h) })
		end
		tb:GetPropertyChangedSignal("Text"):Connect(run)
		tb.FocusLost:Connect(function() task.delay(0.25, function() if tb.Text == "" then sObj:Close() end end) end)
	end

	win.FoldersUI = win:_buildFolders(foldersBtn)
	win:_buildShortcuts()
	win:_buildOpenButton(o.OpenButton or o.Open or {})

	-- ---------- Intro: full cover + HE logo + loader ----------
	task.spawn(function()
		local cover = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(999, 999), BackgroundColor3 = Color3.new(0, 0, 0), Active = true, ZIndex = 1000, Parent = Gui })
		local logo = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, -34), Size = UDim2.fromOffset(104, 80), BackgroundTransparency = 1, ZIndex = 1001, Parent = Gui })
		local pieces = {
			-- H
			{ 0, 0, 12, 80 }, { 38, 0, 12, 80 }, { 0, 34, 50, 12 },
			-- E (glued to the H)
			{ 50, 0, 12, 80 }, { 62, 0, 42, 12 }, { 62, 34, 30, 12 }, { 62, 68, 42, 12 },
		}
		local parts = {}
		for idx, p in ipairs(pieces) do
			local f = New("Frame", { Position = UDim2.fromOffset(p[1], p[2] + 8), Size = UDim2.fromOffset(p[3], p[4]), BackgroundColor3 = T.white, BackgroundTransparency = 1, ZIndex = 1002, Parent = logo })
			parts[idx] = f
			task.delay((idx - 1) * 0.07, function()
				Tw(f, 0.4, { BackgroundTransparency = 0, Position = UDim2.fromOffset(p[1], p[2]) })
			end)
		end
		local msg = New("TextLabel", { Text = "Initializing core...", TextSize = 12, TextColor3 = T.sub, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, 34), Size = UDim2.fromOffset(280, 18), ZIndex = 1001, Parent = Gui })
		local barBg = New("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, 60), Size = UDim2.fromOffset(220, 3), BackgroundColor3 = Color3.fromRGB(30, 30, 30), ZIndex = 1001, Parent = Gui })
		local barFill = New("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.white, ZIndex = 1002, Parent = barBg })
		local steps = {
			{ "Initializing core...", 0.22 }, { "Loading modules...", 0.48 }, { "Building interface...", 0.74 },
			{ "Applying theme...", 0.92 }, { "Welcome, " .. LocalPlayer.DisplayName, 1 },
		}
		for _, s in ipairs(steps) do
			msg.Text = s[1]
			Tw(barFill, 0.55, { Size = UDim2.fromScale(s[2], 1) }, Enum.EasingStyle.Sine)
			task.wait(0.6)
		end
		task.wait(0.25)
		for _, p in ipairs(parts) do Tw(p, 0.4, { BackgroundTransparency = 1 }) end
		Tw(msg, 0.4, { TextTransparency = 1 })
		Tw(barBg, 0.4, { BackgroundTransparency = 1 })
		Tw(barFill, 0.4, { BackgroundTransparency = 1 })
		Tw(cover, 0.55, { BackgroundTransparency = 1 })
		task.wait(0.6)
		cover:Destroy(); logo:Destroy(); msg:Destroy(); barBg:Destroy()
		win.OpenBtn.Visible = true
		if o.StartHidden then win.Hidden = true else win:Show() end
	end)

	return win
end


return Lib
