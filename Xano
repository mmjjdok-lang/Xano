-- ---------------------- Dropdown core ----------------------
local function PlacePopup(win, anchor, w, h)
	local s = win.UIScale.Scale
	local ap = (anchor.AbsolutePosition - win.Main.AbsolutePosition) / s
	local as = anchor.AbsoluteSize / s
	local x = math.clamp(ap.X + as.X - w, 4, math.max(win.W - w - 4, 4))
	local below = win.H - (ap.Y + as.Y + 4) - 4
	local above = ap.Y - 8
	if h <= below or below >= above then
		return x, ap.Y + as.Y + 4, false, math.min(h, math.max(below, 60))
	end
	return x, ap.Y - 4, true, math.min(h, math.max(above, 60))
end

local function DropdownCore(win, anchor, o, valueLabel)
	local opts = o.Options or o.Values or {}
	local multi = o.Multi and true or false
	local selected = {}
	local value = nil
	if multi then
		for _, v in ipairs(type(o.Default) == "table" and o.Default or {}) do selected[v] = true end
	else
		value = o.Default
	end
	local obj = { Options = opts }
	local popup, list, search
	local isOpen = false

	local function text()
		if multi then
			local t = {}
			for _, v in ipairs(opts) do if selected[v] then t[#t + 1] = tostring(v) end end
			return #t > 0 and table.concat(t, ", ") or "None"
		end
		return value ~= nil and tostring(value) or "None"
	end
	local function refreshText() if valueLabel then valueLabel.Text = text() end end
	refreshText()

	local function result()
		if not multi then return value end
		local t = {}
		for _, v in ipairs(opts) do if selected[v] then t[#t + 1] = v end end
		return t
	end

	local function rebuildItems()
		for _, c in ipairs(list:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
		for idx, opt in ipairs(opts) do
			local isSel = multi and selected[opt] or (not multi and value == opt)
			local b = New("TextButton", {
				Name = tostring(opt), Text = "   " .. tostring(opt), Size = UDim2.new(1, 0, 0, 26), LayoutOrder = idx,
				BackgroundColor3 = T.item2, BackgroundTransparency = isSel and 0 or 1,
				TextColor3 = isSel and T.white or T.sub, TextSize = 12, Parent = list,
			})
			Corner(b, 5)
			b.MouseEnter:Connect(function() if not (multi and selected[opt] or (not multi and value == opt)) then Tw(b, 0.1, { BackgroundTransparency = 0.6 }) end end)
			b.MouseLeave:Connect(function() if not (multi and selected[opt] or (not multi and value == opt)) then Tw(b, 0.15, { BackgroundTransparency = 1 }) end end)
			b.Activated:Connect(function()
				Click()
				if multi then
					selected[opt] = not selected[opt] or nil
					refreshText()
					Safe(o.Callback, result())
					rebuildItems()
				else
					value = opt
					refreshText()
					Safe(o.Callback, value)
					obj:Close()
				end
			end)
		end
	end

	local function build()
		popup = New("Frame", { Visible = false, BackgroundColor3 = T.panel, ClipsDescendants = true, ZIndex = 2, Parent = win.Overlay })
		Corner(popup, 6)
		Stroke(popup, T.stroke, 1)
		local top = 4
		if o.Search then
			local sb = New("Frame", { Size = UDim2.new(1, -12, 0, 26), Position = UDim2.fromOffset(6, 6), BackgroundColor3 = T.item, Parent = popup })
			Corner(sb, 5)
			MakeIcon(sb, SEARCH_IMG, "🔍", 14, UDim2.fromOffset(7, 6))
			search = New("TextBox", { PlaceholderText = "Search...", PlaceholderColor3 = T.sub, ClearTextOnFocus = false, TextSize = 12, Size = UDim2.new(1, -30, 1, 0), Position = UDim2.fromOffset(26, 0), Parent = sb })
			top = 36
			search:GetPropertyChangedSignal("Text"):Connect(function()
				local q = string.lower(search.Text)
				for _, c in ipairs(list:GetChildren()) do
					if c:IsA("TextButton") then c.Visible = q == "" or string.find(string.lower(c.Name), q, 1, true) ~= nil end
				end
			end)
		end
		list = New("ScrollingFrame", { Position = UDim2.fromOffset(0, top), Size = UDim2.new(1, 0, 1, -(top + 4)), Parent = popup })
		New("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
		New("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), Parent = list })
		popup:SetAttribute("top", top)
	end

	function obj:Open()
		if isOpen then return end
		if not popup then build() end
		rebuildItems()
		if search then search.Text = "" end
		local w = math.max(anchor.AbsoluteSize.X / win.UIScale.Scale, 150)
		local want = #opts * 28 + popup:GetAttribute("top") + 8
		local x, y, up, h = PlacePopup(win, anchor, w, math.min(want, 190))
		popup.AnchorPoint = Vector2.new(0, up and 1 or 0)
		popup.Position = UDim2.fromOffset(x, y)
		popup.Size = UDim2.fromOffset(w, 0)
		popup.Visible = true
		win:_setPopup(obj, true)
		isOpen = true
		Tw(popup, 0.24, { Size = UDim2.fromOffset(w, h) })
	end
	function obj:Close()
		if not isOpen then return end
		isOpen = false
		win:_clearPopup(obj)
		Tw(popup, 0.16, { Size = UDim2.fromOffset(popup.Size.X.Offset, 0) })
		task.delay(0.18, function() if not isOpen and popup then popup.Visible = false end end)
	end
	function obj:Toggle() if isOpen then obj:Close() else obj:Open() end end
	function obj:Set(v)
		if multi then
			selected = {}
			for _, x in ipairs(type(v) == "table" and v or {}) do selected[x] = true end
		else
			value = v
		end
		refreshText()
		Safe(o.Callback, result())
	end
	function obj:Get() return result() end
	function obj:Refresh(newOpts)
		opts = newOpts or {}
		obj.Options = opts
		if not multi and value ~= nil and not table.find(opts, value) then value = nil end
		refreshText()
		if isOpen then rebuildItems() end
	end
	return obj
end

