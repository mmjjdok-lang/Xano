	vp.CurrentCamera = cam
	New("TextLabel", { Text = o.Name or "Avatar Effects", Font = Enum.Font.GothamBold, TextSize = 14, Position = UDim2.fromOffset(126, 10), Size = UDim2.new(1, -200, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd, Parent = card })
